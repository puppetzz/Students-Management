// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

generator kysely {
    provider     = "prisma-kysely"
    output       = "../src/server/kysely"
    fileName     = "types.ts"
    enumFileName = "enums.ts"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id            String    @id @default(cuid())
    username      String    @unique
    passwordHash  String    @map("password_hash")
    emailVerified DateTime? @map("email_verified")
    role          EUserRole @default(USER)
    createdAt     DateTime  @default(now()) @map("created_at")
    updatedAt     DateTime  @default(now()) @map("updated_at")

    @@index([username])
    @@map("users")
}

model Students {
    id                Int       @id @default(autoincrement())
    firstName         String    @map("first_name")
    lastName          String    @map("last_name")
    dayOfBirth        DateTime  @map("day_of_birth")
    hometown          String?
    permanentAddress  String?   @map("permanent_address")
    vneid             String    @unique
    avgScoredSubjects Float     @default(0) @map("avg_scored_subjects")
    avgOverall        Float?    @map("avg_overall")
    conduct           EConduct?
    createdAt         DateTime  @default(now()) @map("created_at")
    updatedAt         DateTime  @default(now()) @map("updated_at")
    classId           Int       @map("class_id")
    imageKey          String?   @map("image_key")

    class Classes @relation(fields: [classId], references: [id])

    examResults ExamResults[]

    @@index([classId])
    @@index([firstName, lastName])
    @@index([createdAt])
    @@map("students")
}

model Classes {
    id          Int      @id @default(autoincrement())
    name        String
    description String?
    termId      Int      @map("term_id")
    createdAt   DateTime @default(now()) @map("created_at")
    updatedAt   DateTime @default(now()) @map("updated_at")

    classSubjects ClassSubjects[]
    term          Terms           @relation(fields: [termId], references: [id])
    students      Students[]

    @@index([termId])
    @@index([name])
    @@map("classes")
}

model Terms {
    id         Int      @id @default(autoincrement())
    name       String
    schoolYear String
    createdAt  DateTime @default(now()) @map("created_at")
    updatedAt  DateTime @default(now()) @map("updated_at")

    classes Classes[]

    @@index([schoolYear])
    @@index([name])
    @@map("terms")
}

model Subjects {
    id          Int      @id @default(autoincrement())
    code        String   @unique
    name        String
    description String?
    createdAt   DateTime @default(now()) @map("created_at")
    updatedAt   DateTime @default(now()) @map("updated_at")

    classSubjects ClassSubjects[]
    examResults   ExamResults[]

    @@index([name])
    @@index([code])
    @@map("subjects")
}

model ExamResults {
    studentId Int      @map("student_id")
    subjectId Int      @map("subject_id")
    scored    Float
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @default(now()) @map("updated_at")

    student Students @relation(fields: [studentId], references: [id])
    subject Subjects @relation(fields: [subjectId], references: [id])

    @@id([studentId, subjectId])
    @@index([studentId])
    @@index([subjectId])
    @@index([scored])
    @@map("exam_results")
}

model ClassSubjects {
    classId   Int @map("class_id")
    subjectId Int @map("subject_id")

    class   Classes  @relation(fields: [classId], references: [id])
    subject Subjects @relation(fields: [subjectId], references: [id])

    @@id([classId, subjectId])
    @@index([classId])
    @@index([subjectId])
    @@map("class_subjects")
}

enum EConduct {
    POOR
    AVERAGE
    GOOD
    EXCELLENT
}

enum EUserRole {
    SUPER_ADMIN
    ADMIN
    USER
}
