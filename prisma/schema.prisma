// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

generator kysely {
    provider     = "prisma-kysely"
    output       = "../src/server/kysely"
    fileName     = "types.ts"
    enumFileName = "enums.ts"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id            String    @id @default(cuid())
    username      String    @unique
    passwordHash  String    @map("password_hash")
    emailVerified DateTime? @map("email_verified")
    role          EUserRole @default(USER)
    createdAt     DateTime  @default(now()) @map("created_at")
    updatedAt     DateTime  @default(now()) @map("updated_at")

    @@index([username])
    @@map("users")
}

model Students {
    id                Int       @id @default(autoincrement())
    firstName         String    @map("first_name")
    lastName          String    @map("last_name")
    vneid             String    @unique
    avgScoredSubjects Float     @default(0) @map("avg_scored_subjects")
    avgOverall        Float?    @map("avg_overall")
    conduct           EConduct?
    isDeleted         Boolean   @default(false) @map("is_deleted")
    createdAt         DateTime  @default(now()) @map("created_at")
    updatedAt         DateTime  @default(now()) @map("updated_at")
    deletedAt         DateTime? @map("deleted_at")
    classId           Int       @map("class_id")
    imageKey          String?   @map("image_key")

    class           Classes          @relation(fields: [classId], references: [id])
    examResults     ExamResults[]
    studentProfiles StudentProfiles?

    @@index([classId])
    @@index([lastName, firstName])
    @@index([createdAt])
    @@map("students")
}

model StudentProfiles {
    id                          Int       @id @default(autoincrement())
    studentId                   Int       @unique @map("student_id")
    gender                      EGender
    dayOfBirth                  DateTime  @map("day_of_birth")
    placeOfBirth                String?   @map("place_of_birth")
    ethnicity                   String?
    religion                    String?
    vneidIssuedDate             DateTime? @map("vneid_issued_date")
    vneidIssuedPlace            String?   @map("vneid_issued_place")
    hometown                    String?
    permanentAddress            String?   @map("permanent_address")
    educationLevel              String?   @map("education_level") //e.g. "12/12"
    youthUnionAdmissionDate     DateTime? @map("youth_union_admission_date")
    communistPartyAdmissionDate DateTime? @map("communist_party_admission_date")
    phoneNumber                 String?   @map("phone_number")
    email                       String?   @unique
    fatherName                  String?   @map("father_name")
    fatherOccupation            String?   @map("father_occupation")
    fatherAddress               String?   @map("father_address")
    fatherDayOfBirth            DateTime? @map("father_day_of_birth")
    motherName                  String?   @map("mother_name")
    motherOccupation            String?   @map("mother_occupation")
    motherAddress               String?   @map("mother_address")
    motherDayOfBirth            DateTime? @map("mother_day_of_birth")
    createdAt                   DateTime  @default(now()) @map("created_at")
    updatedAt                   DateTime  @default(now()) @map("updated_at")

    student Students @relation(fields: [id], references: [id])

    @@index([studentId])
    @@map("student_profiles")
}

model Classes {
    id                Int       @id @default(autoincrement())
    name              String
    description       String?
    termId            Int       @map("term_id")
    trainingProgramId Int       @map("training_program_id")
    isDeleted         Boolean   @default(false) @map("is_deleted")
    createdAt         DateTime  @default(now()) @map("created_at")
    updatedAt         DateTime  @default(now()) @map("updated_at")
    deletedAt         DateTime? @map("deleted_at")

    term            Terms           @relation(fields: [termId], references: [id])
    trainingProgram TrainingProgram @relation(fields: [trainingProgramId], references: [id])
    students        Students[]

    @@index([termId])
    @@index([name])
    @@map("classes")
}

model Terms {
    id         Int       @id @default(autoincrement())
    name       String
    schoolYear String
    createdAt  DateTime  @default(now()) @map("created_at")
    updatedAt  DateTime  @default(now()) @map("updated_at")
    isDeleted  Boolean   @default(false) @map("is_deleted")
    deletedAt  DateTime? @map("deleted_at")

    classes Classes[]

    @@index([schoolYear])
    @@index([name])
    @@index([isDeleted])
    @@map("terms")
}

model Subjects {
    id               Int       @id @default(autoincrement())
    code             String    @unique
    name             String
    scoreCoefficient Int       @default(1) @map("score_coefficient")
    description      String?
    material         Json?
    isDeleted        Boolean   @default(false) @map("is_deleted")
    createdAt        DateTime  @default(now()) @map("created_at")
    updatedAt        DateTime  @default(now()) @map("updated_at")
    deletedAt        DateTime? @map("deleted_at")

    examResults             ExamResults[]
    trainingProgramSubjects TrainingProgramSubjects[]

    @@index([name])
    @@index([code])
    @@index([isDeleted])
    @@map("subjects")
}

model ExamResults {
    studentId Int      @map("student_id")
    subjectId Int      @map("subject_id")
    scored    Float
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @default(now()) @map("updated_at")

    student Students @relation(fields: [studentId], references: [id])
    subject Subjects @relation(fields: [subjectId], references: [id])

    @@id([studentId, subjectId])
    @@index([studentId])
    @@index([subjectId])
    @@index([scored])
    @@map("exam_results")
}

model TrainingProgramSubjects {
    trainingProgramId Int @map("training_program_id")
    subjectId         Int @map("subject_id")

    trainingProgram TrainingProgram @relation(fields: [trainingProgramId], references: [id])
    subject         Subjects        @relation(fields: [subjectId], references: [id])

    @@id([trainingProgramId, subjectId])
    @@index([trainingProgramId])
    @@index([subjectId])
    @@map("training_program_subjects")
}

model TrainingProgram {
    id          Int       @id @default(autoincrement())
    name        String
    description String?
    isDeleted   Boolean   @default(false) @map("is_deleted")
    createdAt   DateTime  @default(now()) @map("created_at")
    updatedAt   DateTime  @default(now()) @map("updated_at")
    deletedAt   DateTime? @map("deleted_at")

    trainingProgramSubjects TrainingProgramSubjects[]
    classes                 Classes[]

    @@index([name])
    @@index([isDeleted])
    @@map("training_programs")
}

enum EConduct {
    POOR
    AVERAGE
    GOOD
    EXCELLENT
}

enum EUserRole {
    SUPER_ADMIN
    ADMIN
    USER
}

enum EGender {
    MALE
    FEMALE
    OTHER
}
